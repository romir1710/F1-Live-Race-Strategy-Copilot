# ─── Neon PostgreSQL ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL_SYNC=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# ─── Aiven Kafka ───────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=your-kafka-service.aiven.io:12345
KAFKA_SASL_USERNAME=avnadmin
KAFKA_SASL_PASSWORD=your-password
KAFKA_CA_CERT_PATH=./kafka-ca.pem

# ─── Upstash Redis ─────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ── Google AI (Gemini 3.6 Flash — free tier, AI Studio, Sep 2026) ────────────────
GOOGLE_API_KEY=your-google-ai-studio-key

# ─── App config ────────────────────────────────────────────────────────────────
REPLAY_SPEED=1.0          # seconds per simulated lap (1.0 = 1 lap/sec real time)
SESSION_KEY=9158          # 2024 Bahrain Race session key — set after Phase 1 validation
PORT=8000
ENVIRONMENT=development   # or production
