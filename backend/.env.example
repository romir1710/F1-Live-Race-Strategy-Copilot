# ─── Neon PostgreSQL ────────────────────────────────────────────────────────────
# asyncpg format for FastAPI runtime (postgresql+asyncpg://...)
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.neon.tech/neondb?sslmode=require
# psycopg2 format for Alembic migrations and the one-shot data seeder
DATABASE_URL_SYNC=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# ── Google AI (Gemini 3.6 Flash — free tier, AI Studio, Sep 2026) ─────────────
GOOGLE_API_KEY=your-google-ai-studio-key

# ─── App config ─────────────────────────────────────────────────────────────────
REPLAY_SPEED=1.0          # seconds per simulated lap (1.0 = 1 lap/sec real time)
SESSION_KEY=9158          # 2024 Bahrain Race session key — set after data seeder runs
FOCUS_DRIVERS=1,11,16     # comma-separated driver numbers — set after data seeder runs
PORT=8000
ENVIRONMENT=development   # or production
